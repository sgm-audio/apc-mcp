{
  "name": "@sgm-audio/apc-mcp",
  "version": "2.0.0",
  "description": "MCP server for audio plugin development \u2014 CMake build, test, lint, and project management for JUCE, CLAP and VST3 plugin projects",
  "type": "module",
  "bin": {
    "apc-mcp": "./index.js"
  },
  "files": [
    "index.js",
    "templates/"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint . && node --check index.js",
    "audit": "npm audit && echo '\u2705 No known vulnerabilities'",
    "licenses": "node scripts/check-licenses.mjs",
    "smoke": "node scripts/smoke-scaffold.mjs",
    "smoke:configure": "node scripts/smoke-scaffold.mjs --configure",
    "quality": "npm run lint && npm test",
    "security": "npm audit --audit-level=high && echo '\u2705 Security gate passed'",
    "check": "npm run quality && npm run smoke && npm run audit && npm run licenses",
    "ship": "node scripts/ship.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sgm-audio/apc-mcp.git"
  },
  "homepage": "https://github.com/sgm-audio/apc-mcp",
  "bugs": "https://github.com/sgm-audio/apc-mcp/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "audio-plugin",
    "juce",
    "clap",
    "vst3",
    "cmake",
    "audio",
    "dsp",
    "modelcontextprotocol"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0"
  }
}
