{
  "name": "@sgm-audio/apc-mcp",
  "version": "2.0.0",
  "description": "MCP server for audio plugin development \u2014 CMake build, test, lint, and project management for JUCE, CLAP, VST3, and LV2 plugin projects",
  "type": "module",
  "bin": {
    "apc-mcp": "./index.js"
  },
  "files": [
    "index.js",
    "templates/"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint . && node --check index.js",
    "audit": "npm audit && echo '\u2705 No known vulnerabilities'",
    "licenses": "node scripts/check-licenses.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "smoke": "node scripts/smoke-scaffold.mjs",
    "smoke:configure": "node scripts/smoke-scaffold.mjs --configure",
    "smoke:validate": "node scripts/smoke-validate.mjs",
    "smoke:jive": "node scripts/smoke-jive.mjs",
    "cmake:lint": "cmake-lint templates/*/CMakeLists.txt",
    "quality": "npm run lint && npm run typecheck && npm test",
    "security": "npm audit && echo '\u2705 Security gate passed'",
    "check": "npm run quality && npm run smoke && npm run audit && npm run licenses && npm run docs:check",
    "ship": "node scripts/ship.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sgm-audio/apc-mcp.git"
  },
  "homepage": "https://github.com/sgm-audio/apc-mcp",
  "bugs": "https://github.com/sgm-audio/apc-mcp/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "audio-plugin",
    "juce",
    "clap",
    "vst3",
    "lv2",
    "cmake",
    "audio",
    "dsp",
    "modelcontextprotocol"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-n": "^18.5.0",
    "typescript": "^7.0.2"
  }
}
