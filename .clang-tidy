# clang-tidy configuration for the C and C++ that templates/{clap,lv2} generate.
#
# Run through `node scripts/smoke-scaffold.mjs --build --clang-tidy` (and by the
# scaffolded-build CI jobs), which passes this file with `--config-file=` because
# the scaffolded sources live in a temp directory that clang-tidy's own upward
# search never resolves to this repository.
#
# Scope: the analyzers, plus the classes of defect that bit these templates
# before — uninitialised state, discarded return values, and integer-width
# mistakes. The style families (readability-*, cppcoreguidelines-*, modernize-*)
# are deliberately absent: they rewrite working code to taste, and a scaffold
# that ships a stranger's taste is not thereby more correct.
#
# Three checks are disabled, and no others:
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#       recommends the C11 Annex K functions (memset_s, ...). Neither glibc nor
#       macOS libc implements Annex K, so the advice cannot be followed on any
#       platform these templates target, and the memset it flags is correct.
#   bugprone-easily-swappable-parameters
#       fires on every two-argument function taking the same type, which is
#       every LV2/C callback signature; renaming the parameters would not make
#       the generated plugin safer.
#   portability-avoid-pragma-once
#       the templates use `#pragma once`, which GCC, Clang and MSVC all support
#       and which cannot desynchronise the way a copied include guard can. The
#       check exists for compilers these templates are not built with.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once

# A finding is a failure. A warning that nobody fails on is a warning nobody
# reads; smoke-scaffold treats "warning not promoted to error" as proof that this
# file was not loaded.
WarningsAsErrors: '*'

# Diagnose the generated sources in Source/ too, not just the .c/.cpp files
# clang-tidy is invoked on.
HeaderFilterRegex: 'Source/'

FormatStyle: none
